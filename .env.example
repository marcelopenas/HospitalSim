# Local development values only. Change passwords before sharing a deployment.
MYSQL_DATABASE=hospitalsim
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_USER=hospitalsim
MYSQL_PASSWORD=change-me-app-local-only
# Used by local Python development; Compose supplies its own db hostname.
DATABASE_URL=mysql+pymysql://hospitalsim:change-me-app-local-only@localhost:3306/hospitalsim
SQL_ECHO=false
# Optional absolute Swagger URL, embedded at frontend build time.
# Empty means http://<current browser hostname>:8080/docs.
VITE_SWAGGER_URL=
